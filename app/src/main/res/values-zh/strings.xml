    <string name="how_to_pick">选一根</string>
    <string name="how_to_pick_hand">手：眼睛看着窗口里的 ①–⑥，手指捏一下。</string>
    <string name="how_to_pick_pad">手柄：射线指着编号，扣扳机。</string>
    <string name="how_to_move">挪它</string>
    <string name="how_to_move_hand">手：看着亮起的方向键，捏一下。它顺着槽滑到顶。</string>
    <string name="how_to_move_pad">手柄：射线指着方向键，扣扳机。</string>
    <string name="how_to_turn">转锁看</string>
    <string name="how_to_turn_hand">手：看着 [左转] [右转] [翻个面]，捏一下。</string>
    <string name="how_to_turn_pad">手柄：射线指着按钮，扣扳机。</string>
    <string name="how_to_stuck">卡住了</string>
    <string name="how_to_stuck_hand">手：捏 [给个提示]，它亮出下一步，还告诉你为什么。</string>
    <string name="how_to_stuck_pad">手柄：射线指着 [给个提示]，扣扳机。</string>
    <string name="how_to_place">挪锁和窗口</string>
